# AI narration is optional; every var below is unset by default and the app
# uses written-in template narration instead. See README's "AI narration"
# section for what the AI writes and what it can never touch.
AI_BASE_URL=     # chat-completions endpoint; defaults to https://api.openai.com/v1/chat/completions
AI_API_KEY=      # gateway credential; falls back to OPENAI_API_KEY below if unset
AI_MODEL=        # model identifier; defaults to gpt-4.1-mini
AI_AUTH_HEADER=  # request header carrying the credential; defaults to "Authorization"
AI_AUTH_PREFIX=  # value prefix before the credential; defaults to "Bearer " (with trailing space)

OPENAI_API_KEY=
TUTU_MCP_URL=https://mcp.tutu.ru/mcp
